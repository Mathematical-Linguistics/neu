(lang dune 3.24)
(name neu)
(version 0.1.0)
(sections (lib .) (libexec .) (bin ../../bin))
(files
 (lib
  (META
   core/ast.ml
   core/eval.ml
   core/lexer.ml
   core/neu_core.a
   core/neu_core.cma
   core/neu_core.cmi
   core/neu_core.cmt
   core/neu_core.cmx
   core/neu_core.cmxa
   core/neu_core.ml
   core/neu_core__Ast.cmi
   core/neu_core__Ast.cmt
   core/neu_core__Ast.cmx
   core/neu_core__Eval.cmi
   core/neu_core__Eval.cmt
   core/neu_core__Eval.cmx
   core/neu_core__Lexer.cmi
   core/neu_core__Lexer.cmt
   core/neu_core__Lexer.cmx
   core/neu_core__P4_codegen.cmi
   core/neu_core__P4_codegen.cmt
   core/neu_core__P4_codegen.cmx
   core/neu_core__Parser.cmi
   core/neu_core__Parser.cmt
   core/neu_core__Parser.cmti
   core/neu_core__Parser.cmx
   core/neu_core__Typecheck.cmi
   core/neu_core__Typecheck.cmt
   core/neu_core__Typecheck.cmx
   core/p4_codegen.ml
   core/parser.ml
   core/parser.mli
   core/typecheck.ml
   dune-package
   opam))
 (libexec (core/neu_core.cmxs))
 (bin (neu)))
(library
 (name neu.core)
 (kind normal)
 (archives (byte core/neu_core.cma) (native core/neu_core.cmxa))
 (plugins (byte core/neu_core.cma) (native core/neu_core.cmxs))
 (native_archives core/neu_core.a)
 (requires menhirLib)
 (main_module_name Neu_core)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name neu_core)
     (visibility public)
     (kind alias)
     (source (path Neu_core) (impl (path core/neu_core.ml-gen))))
    (name Neu_core)
    (modules
     (module
      (obj_name neu_core__Ast)
      (visibility public)
      (source (path Ast) (impl (path core/ast.ml))))
     (module
      (obj_name neu_core__Eval)
      (visibility public)
      (source (path Eval) (impl (path core/eval.ml))))
     (module
      (obj_name neu_core__Lexer)
      (visibility public)
      (source (path Lexer) (impl (path core/lexer.ml))))
     (module
      (obj_name neu_core__P4_codegen)
      (visibility public)
      (source (path P4_codegen) (impl (path core/p4_codegen.ml))))
     (module
      (obj_name neu_core__Parser)
      (visibility public)
      (source
       (path Parser)
       (intf (path core/parser.mli))
       (impl (path core/parser.ml))))
     (module
      (obj_name neu_core__Typecheck)
      (visibility public)
      (source (path Typecheck) (impl (path core/typecheck.ml))))))
   (wrapped true))))
